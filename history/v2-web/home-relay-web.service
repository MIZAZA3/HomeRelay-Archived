[Unit]
Description=Isolated HomeRelay HTTPS administration gateway
After=network.target home-relay-v2-controller.service
[Service]
Type=simple
DynamicUser=yes
User=home-relay-web
WorkingDirectory=/opt/home-relay-web
LoadCredential=web.json:/etc/home-relay-web/web.json
ExecStart=/usr/bin/python3 /opt/home-relay-web/web_gateway.py
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
InaccessiblePaths=/opt/1panel /etc/ssh /etc/home-relay-v2 /var/lib/home-relay-v2 -/etc/gost-home-relay -/run/docker.sock -/var/lib/docker
RestrictAddressFamilies=AF_INET AF_UNIX
IPAddressDeny=any
IPAddressAllow=127.0.0.0/8
SocketBindDeny=any
SocketBindAllow=ipv4:tcp:18782
CPUQuota=10%
MemoryMax=80M
TasksMax=32
LimitNOFILE=128
[Install]
WantedBy=multi-user.target
